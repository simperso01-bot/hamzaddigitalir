---
import config from "@/config/config.json";
import DynamicIcon from "@/helpers/DynamicIcon";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

const contact = (await getEntry(
  "contact",
  "-index"
)) as CollectionEntry<"contact">;

const { contact_form_action }: { contact_form_action: string } = config.params;
const { title, social_links, meta_title, description } = contact.data;
---

<Base title={title} meta_title={meta_title} description={description}>
  <section class="section">
    <div class="container">
      <div class="row relative pb-16">
        <Image
          width={1280}
          height={800}
          class="-z-[1] object-cover object-top absolute inset-0"
          src={"/images/map.png"}
          alt=""
          aria-hidden="true"
          format="webp"
        />
        <div class="lg:col-6">
          <h1
            class="my-10 lg:my-11 lg:pt-11 text-center lg:text-start lg:text-[64px]"
            set:html={markdownify(title || "")}
          />
        </div>
        <div
          class="contact-form-wrapper rounded border border-border p-6 dark:border-darkmode-border lg:col-6">
          <h2>
            برای ما
            <span
              class="ms-1.5 inline-flex items-center text-primary dark:text-darkmode-primary">
              پیام بفرستید
              <DynamicIcon icon="FaArrowLeft" className="ms-1" />
            </span>
          </h2>
          <form
            class="contact-form mt-12"
            method="POST"
            action={contact_form_action}>
            <div class="mb-6">
              <label class="mb-2 block font-secondary" for="name">
                نام و نام خانوادگی
                <small
                  class="font-secondary text-sm text-primary dark:text-darkmode-primary">
                  *</small
                >
              </label>
              <input
                class="form-input w-full"
                id="name"
                name="name"
                type="text"
                placeholder="نام شما"
                required
              />
            </div>
            <div class="mb-6">
              <label class="mb-2 block font-secondary" for="email">
                ایمیل
                <small
                  class="font-secondary text-sm text-primary dark:text-darkmode-primary">
                  *</small
                >
              </label>
              <input
                class="form-input w-full"
                id="email"
                name="email"
                type="email"
                dir="ltr"
                inputmode="email"
                placeholder="name@example.com"
                required
              />
            </div>
            <div class="mb-6">
              <label class="mb-2 block font-secondary" for="subject">
                موضوع
                <small
                  class="font-secondary text-sm text-primary dark:text-darkmode-primary">
                  *</small
                >
              </label>
              <input
                class="form-input w-full"
                id="subject"
                name="subject"
                type="text"
                placeholder="موضوع پیام"
                required
              />
            </div>
            <div class="mb-6">
              <label class="mb-2 block font-secondary" for="message">
                پیام
                <small
                  class="font-secondary text-sm text-primary dark:text-darkmode-primary">
                  *</small
                >
              </label>
              <textarea
                class="form-textarea w-full"
                id="message"
                name="message"
                placeholder="پیام خود را بنویسید…"
                rows="7"></textarea>
            </div>
            <input class="btn btn-primary" type="submit" value="ارسال" />
          </form>
        </div>
      </div>
      <div class="row">
        {
          social_links.map((link) => (
            <div class="md:col-6 lg:col-4">
              <span
                class="relative my-4 flex h-[100px] items-center justify-center
             rounded border border-border p-4 text-primary dark:text-darkmode-primary dark:border-darkmode-border">
                <DynamicIcon icon={link.icon} />
                <a
                  href={link.link}
                  target="_blank"
                  class="after:absolute after:inset-0 ms-1.5 text-lg font-bold text-text-dark dark:text-darkmode-text-light">
                  {link.content}
                </a>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
