---
import { fa } from "@/lib/utils/fa";

const { tags, categories, allCategories } = Astro.props;
---

<div class="lg:col-4">
  <div class="mb-8">
    <h5 class="mb-6">دسته‌بندی‌ها</h5>
    <div class="rounded bg-light p-8 dark:bg-text-darkmode-light">
      <ul class="space-y-4">
        {
          categories.map((category: any) => {
            const count = allCategories.filter(
              (c: any) => c === category
            ).length;
            return (
              <li>
                <a
                  class="flex justify-between hover:text-primary hover:dark:text-darkmode-primary"
                  href={`/categories/${category}`}>
                  {category} <span>({fa(count)})</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
  <div class="mb-8">
    <h5 class="mb-6">برچسب‌ها</h5>
    <div class="rounded bg-light p-6 dark:bg-text-darkmode-light">
      <ul>
        {
          tags.map((tag: any) => {
            return (
              <li class="inline-block">
                <a
                  class="m-1 block rounded bg-white px-3 py-1 hover:bg-primary hover:text-white dark:bg-darkmode-body dark:hover:bg-text-darkmode-primary dark:hover:text-text-dark"
                  href={`/tags/${tag}`}>
                  {tag}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</div>
