{
  "site": {
    "title": "Geeky Astro",
    "base_url": "https://example.com",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/favicon.png",
    "logo": "/images/logo.png",
    "logo_darkmode": "/images/logo-darkmode.png",
    "logo_width": "150",
    "logo_height": "39",
    "logo_text": "Geeky"
  },

  "settings": {
    "search": true,
    "sticky_header": false,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 6,
    "InnerPaginationOptions": {
      "enableTop": false,
      "enableBottom": true
    },
    "summary_length": 200,
    "post_folder": "posts"
  },

  "params": {
    "contact_form_action": "#",
    "footer_content": "وبلاگی برای نشر نوشته‌ها، یادداشت‌ها و تجربه‌های روزمره با طراحی ساده و خوانا.",
    "copyright": "طراحی و توسعه توسط [Statichunt](https://statichunt.com/)"
  },

  "widgets": {
    "about": {
      "enable": true,
      "content": "اینجا درباره نویسنده، موضوع‌های مورد علاقه و مسیر فعالیت وبلاگ نوشته می‌شود."
    },
    "featured_posts": {
      "enable": true,
      "title": "نوشته‌های برگزیده",
      "showPost": 3
    },
    "categories": {
      "enable": true,
      "title": "دسته‌بندی‌ها"
    },
    "newsletter": {
      "enable": true,
      "title": "خبرنامه",
      "content": "برای دریافت تازه‌ترین نوشته‌ها، ایمیل خود را وارد کنید.",
      "privacy_policy_page": "/privacy-policy",
      "malichipm_url": ""
    }
  },
  "navigation_button": {
    "enable": true,
    "label": "شروع کنید",
    "link": "https://example.com"
  },

  "metadata": {
    "meta_author": "statichunt",
    "meta_image": "/images/og-image.png",
    "meta_description": "قالب وبلاگ فارسی با Astro و Tailwind"
  },

  "disqus": {
    "enable": true,
    "shortname": "themefisher-template",
    "settings": {}
  }
}
